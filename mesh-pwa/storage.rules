rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Marketplace item photos
    match /marketplace/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User photos/avatars/wallpapers/statuses/moods
    match /photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /avatars/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /wallpapers/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /statuses/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /moods/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Allow thread participants to read/write thread attachments
    match /threads/{threadId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Fallback rule for any other files
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
